# Copy this file to .env and fill in whichever provider(s) you want to use.
# Nothing here is required — the app works with sensible defaults if you
# leave it all blank (TF-IDF search, lexical reranking, extractive answers).

# --- Pick one LLM provider ---
LLM_PROVIDER=anthropic          # anthropic | openai | nvidia | deepseek | none

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Optional: real dense embeddings instead of TF-IDF ---
EMBEDDING_PROVIDER=tfidf        # tfidf | openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Optional: real cross-encoder reranking instead of lexical reranking ---
RERANK_PROVIDER=lexical         # lexical | cohere | none
COHERE_API_KEY=

# --- Retrieval tuning ---
FETCH_K=50
TOP_K=3
BM25_WEIGHT=1.0
DENSE_WEIGHT=1.0
MIN_BM25_SCORE=0.0
MIN_DENSE_SCORE=0.05
DEDUPE_ONE_CHUNK_PER_FILE=true

# --- Vector store ---
VECTOR_STORE=qdrant_memory      # qdrant_memory | qdrant_local | qdrant_server
QDRANT_PATH=./qdrant_data
QDRANT_URL=
QDRANT_API_KEY=

# --- Persistence ---
SESSION_STORE=sqlite            # sqlite | memory
SQLITE_PATH=./repo_copilot.db

# --- GitHub API (optional but recommended) ---
GITHUB_TOKEN=

# --- Feature flags ---
ENABLE_CODE_EXECUTION=false
ENABLE_MULTI_QUERY=true
ENABLE_QUERY_EXPANSION=true
ENABLE_AGENTIC_PLANNER=true

# ---------------------------------------------------------------------------
# Agentic platform: Google ADK Repository Agent, LangGraph, ChatNVIDIA, MLflow
# ---------------------------------------------------------------------------

# --- ChatNVIDIA / NVIDIA AI Endpoints (used by the ADK Repository Agent) ---
# This is distinct from NVIDIA_API_KEY/NVIDIA_MODEL above (app/providers.py's
# OpenAI-compatible path) — both read the same NVIDIA_API_KEY, but this one
# drives the LangChain-native ChatNVIDIA client and the ADK agent's model.
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
ENABLE_REASONING=false
REASONING_BUDGET=4096
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
LLM_FALLBACK_PROVIDER=

# --- Agent framework ---
AGENT_FRAMEWORK=adk             # adk (Google ADK, needs NVIDIA_API_KEY) | direct (LangGraph workflow only)
AGENT_MAX_RETRIES=2

# --- Repository ingestion limits ---
MAX_REPOSITORY_SIZE=500
MAX_FILES=5000
MAX_FILE_SIZE=500000
MAX_CHUNKS=20000
CLONE_TIMEOUT=180
INDEX_TIMEOUT=300

# --- Memory / persistence ---
REDIS_URL=
MAX_HISTORY_TURNS_SENT_TO_LLM=6

# --- CORS / internal endpoints ---
CORS_ORIGINS=*
INTERNAL_API_TOKEN=

# --- MLflow (local SQLite by default; no server required) ---
MLFLOW_TRACKING_URI=sqlite:///./mlflow.db
MLFLOW_EXPERIMENT_NAME=repo-copilot
ENABLE_MLFLOW=true

# --- LangSmith tracing (optional; read directly by LangChain, not by this app) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=repo-copilot

APP_ENV=development
